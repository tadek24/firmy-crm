# Set these in Vercel Settings > Environment Variables; never commit real values.
CEIDG_API_TOKEN=""
# Supabase Connect > Transaction pooler URI, server-side only.
SUPABASE_DATABASE_URL=""
# At least 12 characters.
CRM_PASSWORD=""
# Random secret, at least 32 characters.
CRM_SESSION_SECRET=""
# Server-side only. Enable after adding a funded OpenAI API key in Vercel.
OPENAI_API_KEY=""
CRM_AI_ENABLED="false"
CRM_AI_DAILY_LIMIT="50"

# Alternative pilot: use a Google project on Free tier WITHOUT Cloud Billing.
# Never automatically fall back to the paid OpenAI provider.
CRM_AI_PROVIDER="gemini"
GEMINI_API_KEY=""
CRM_GEMINI_FREE_TIER_CONFIRMED="false"
